    correctIndex: 2
    successVoice: {fileID: 8300000, guid: 6feabe92f2f103b45af97409310a43b2, type: 3}
    retryVoice: {fileID: 8300000, guid: 01eb8213e3efd934a976460d74bcdda8, type: 3}
    useTypingEffect: 0
    useFloatingImage: 1
  - type: 0
