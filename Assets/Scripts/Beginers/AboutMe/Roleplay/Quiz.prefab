  questions:
  - type: 0
    questionText: What magic word does this child need to say?
    questionAudio: {fileID: 8300000, guid: fa205e179e6e02e4c901b2ec41d39b5d, type: 3}
    questionImage: {fileID: 601691274, guid: 76d981d59d5404441a98586b4aa2354d, type: 3}
    backgroundSprite: {fileID: 0}
    optionLabels:
    - Sorry
    - Thank you
    - Please
    correctIndex: 2
    successVoice: {fileID: 8300000, guid: 6feabe92f2f103b45af97409310a43b2, type: 3}
    retryVoice: {fileID: 8300000, guid: 01eb8213e3efd934a976460d74bcdda8, type: 3}
    useTypingEffect: 0
    useFloatingImage: 1
  - type: 0
    questionText: 'You bump into someone. You say: I am so '
    questionAudio: {fileID: 8300000, guid: 60779caf87aecba4dbdd16c0a83f249d, type: 3}
    questionImage: {fileID: 176872036, guid: 76d981d59d5404441a98586b4aa2354d, type: 3}
    backgroundSprite: {fileID: 0}
    optionLabels:
    - Welcome
    - Sorry
    - Please
    correctIndex: 1
    successVoice: {fileID: 8300000, guid: 6feabe92f2f103b45af97409310a43b2, type: 3}
    retryVoice: {fileID: 8300000, guid: 01eb8213e3efd934a976460d74bcdda8, type: 3}
    useTypingEffect: 0
    useFloatingImage: 1
  - type: 0
    questionText: 'Finish the jingle: When I get something, I say...'
    questionAudio: {fileID: 8300000, guid: 797c5844283a44a489cdb45d819831a5, type: 3}
    questionImage: {fileID: 1626664586, guid: 76d981d59d5404441a98586b4aa2354d, type: 3}
